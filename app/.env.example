# Copy to .env (never commit .env — the repo is public)

# Cloud LLM for recaps and "while you were away" summaries (agent only).
# Without a key, Tap falls back to a template recap (raw transcript).
ANTHROPIC_API_KEY=
TAP_LLM_MODEL=claude-haiku-5-5

# Haptics: HapticWeb plugin by default; later our own plugin (plain HTTP on localhost).
TAP_HAPTIC_URL=https://local.jmw.nz:41443

# The user's name + variants the speech-to-text may produce (comma-separated).
TAP_USER_NAMES=Thibaud,Thibault,Tibo,Thibo

# Speech-to-text engine: "none" (dev text box / mock only), "sherpa" (local, primary), "deepgram" (cloud fallback)
TAP_STT=none
DEEPGRAM_API_KEY=
