# Copy to .env (never commit .env — the repo is public)

# Cloud LLM for recaps and "while you were away" summaries (agent only).
# Without a key, Tap falls back to a template recap (raw transcript).
ANTHROPIC_API_KEY=
TAP_LLM_MODEL=claude-haiku-5-5

# Haptics: HapticWeb plugin by default; later our own plugin (plain HTTP on localhost).
TAP_HAPTIC_URL=https://local.jmw.nz:41443

# The user's name + variants the speech-to-text may produce (comma-separated) — used by the text detector.
TAP_USER_NAMES=Thibaud,Thibault,Tibo,Teebo
# Words the local speech-to-text is biased towards (spell the name as an English speaker would hear it).
TAP_HOTWORDS=Tibo,Teebo,Thibaud,Thibault
TAP_HOTWORDS_SCORE=2.0

# Speech-to-text engine: "sherpa" (local, primary — needs the model, see app/README.md), "none" (dev text box / mock only), "deepgram" (cloud fallback, not built yet)
# Speech-to-text: sherpa (local) | deepgram (cloud, needs DEEPGRAM_API_KEY; best on real calls)
TAP_STT=sherpa
DEEPGRAM_API_KEY=

# Save what Tap hears to demo/recordings/session-*.wav (benchmark speech models on real calls)
TAP_RECORD=0

# Audio extras (B)
# Deepgram language: en (best for English: names 7/7 on our real call) | multi (English + French in the same call)
TAP_STT_LANGUAGE=en
# Soft haptic heads-up when one of these is said (comma-separated, multi-word OK)
TAP_TOPICS=deadline,action item,budget
# Seconds of silence after a question to you before the "they're waiting for you" nudge
TAP_WAIT_SILENCE_S=2.5
# Speaker labels from Deepgram (1 = on)
TAP_DIARIZE=1
# Print the per-second audio level lines ([audio] call_audio: … B/s) — off by default, they flood the terminal
TAP_DEBUG_LEVELS=0
# Extra vibrations for a question to the group (ringing) and topics (soft). Off: Tap uses only 4 signals.
TAP_OPTIONAL_HAPTICS=0
# Meeting summaries: after a goodbye ("bye", "thanks everyone"…) as the last thing said, wait this many seconds of
# silence, then summarize and close the meeting.
TAP_SUMMARY_AFTER_BYE_S=15
# Without a goodbye: a summary "so far" after this many seconds of silence (0 = never by itself).
TAP_SUMMARY_AFTER_S=120
# Speech after this many seconds of silence starts a new meeting (the previous one is summarized first).
TAP_NEW_MEETING_AFTER_S=300
