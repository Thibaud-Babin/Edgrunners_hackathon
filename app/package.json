{
  "name": "tap",
  "version": "0.1.0",
  "description": "Tap: meeting companion for missed moments (LauzHack 2026)",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "mock": "electron-vite dev -- --mock",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/main/detectors/text.test.ts",
    "postinstall": "node scripts/setup-models.mjs",
    "setup-stt": "node scripts/setup-stt.mjs",
    "stt-bench": "node --experimental-strip-types scripts/stt-bench.mts hotwords",
    "dev:call": "electron-vite dev -- --autostart-call",
    "dev:e2e": "electron-vite dev -- --autostart-call --autostart-away"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "dotenv": "^17.2.3",
    "sherpa-onnx-node": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^45.4.1",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  }
}
